SERVICEHUB_MYSQL_IMAGE=sha256:REPLACE_WITH_IMPORTED_MYSQL_IMAGE_ID
SERVICEHUB_TEST_MYSQL_ROOT_PASSWORD=REPLACE_WITH_RANDOM_TEST_ONLY_SECRET
SERVICEHUB_TEST_MYSQL_PASSWORD=REPLACE_WITH_RANDOM_TEST_ONLY_SECRET
SERVICEHUB_TEST_CURSOR_SIGNING_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
