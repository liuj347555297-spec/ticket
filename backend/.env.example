# Only use these values in a local shell or deployment secret store; never commit a real password.
SPRING_PROFILES_ACTIVE=mysql
SERVICEHUB_DB_URL=jdbc:mysql://127.0.0.1:3306/servicehub?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC
SERVICEHUB_DB_USERNAME=servicehub_app
SERVICEHUB_DB_PASSWORD=replace-with-secret
SERVICEHUB_DB_POOL_MAX=20
SERVICEHUB_LOCAL_AUTH_ENABLED=true
# Required together only when the database has no local account yet. Remove bootstrap values after first successful start.
SERVICEHUB_LOCAL_AUTH_BOOTSTRAP_LOGIN=admin
SERVICEHUB_LOCAL_AUTH_BOOTSTRAP_PASSWORD=replace-with-a-unique-12-plus-character-secret
SERVICEHUB_LOCAL_AUTH_BOOTSTRAP_DISPLAY_NAME=平台管理员
SERVICEHUB_LOCAL_AUTH_BOOTSTRAP_ORGANIZATION_ID=LOCAL-ROOT
SERVICEHUB_LOCAL_AUTH_BOOTSTRAP_ORGANIZATION_NAME=平台根组织
